    "sAssist": {
      "x": 6080,
      "y": 1000,
      "w": 420,
      "text": "Assistant corner: the bottom-right 88 × 88 px (plus safe area) belongs to the platform's assistant button on every breakpoint. Mobile tab bar stops 88 px short; desktop content keeps a clear corner; toasts sit bottom-left / centre.",
      "fill": "blue",
      "size": "m"
    },
    "sColour": {
      "x": 6080,
      "y": 1600,
      "w": 420,
      "text": "v2 colour rule: MINT = do (primary actions, toggles, sliders). BLUE = chosen or in progress (selected pills, running jobs). Everything else is neutral navy-grey.",
      "fill": "teal",
      "size": "m"
    },
    "sCreate": {
      "x": 4920,
      "y": 2980,
      "w": 380,
      "text": "Create is a prompt editor: list (toggle each fragment) or raw text, flip to negative, save and reuse, references, then Run now or Schedule. Scheduled runs become named vault sources.",
      "fill": "teal",
      "size": "m"
    },
    "sJobs": {
      "x": 4920,
      "y": 4320,
      "w": 380,
      "text": "No generation preview (jobs are sealed on the partner side): running = style thumbnail + progress only. GPU offline is calm and neutral.",
      "fill": "teal",
      "size": "m"
    },
    "sEditor": {
      "x": 6440,
      "y": 5700,
      "w": 380,
      "text": "Tools: Enhance (one tap), Face swap (pick one or more characters — matched by gender/age), Blur (strength, always the last step), Edit (soon). History is a single line; the only rollback is \"Remove blur\", which restores the image just before blur.",
      "fill": "teal",
      "size": "m"
    },
    "sChars": {
      "x": 4920,
      "y": 7040,
      "w": 380,
      "text": "Gender and age are matching hints for the partner (\"Any\" = no filter). Inline pills, no form fields.",
      "fill": "teal",
      "size": "m"
    },
    "sAuto": {
      "x": 4920,
      "y": 9700,
      "w": 380,
      "text": "A workflow watches sources (scheduled prompts, iCloud album, Generated…) and runs its steps on each new image: one result per image. Blur is pinned last and keeps the pre-blur copy, so it can be removed afterwards.",
      "fill": "teal",
      "size": "m"
    }
  },
